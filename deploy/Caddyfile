{
	servers {
		# Requests arrive through Vercel, which puts the visitor's IP in X-Forwarded-For.
		# Pass it on, so the app's per-visitor limits see real visitors (with TRUST_PROXY=2).
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

{$DOMAIN} {
	encode gzip
	reverse_proxy app:4000
}

# Pushro Digital Hub's own website and studio (server/src/pushro-site.ts). Point pushro.regularhood.in's DNS (A record)
# at this server; Caddy gets its certificate by itself.
pushro.regularhood.in {
	encode gzip
	reverse_proxy app:4000
}
