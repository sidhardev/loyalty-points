{
	servers {
		# Requests arrive through Vercel, which puts the visitor's IP in X-Forwarded-For.
		# Pass it on, so the app's per-visitor limits see real visitors (with TRUST_PROXY=2).
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

{$DOMAIN} {
	encode gzip
	reverse_proxy app:4000
}

# Phusro Digital Hub's own website and studio (web/public/phusro/). Point phusro.regularhood.in's DNS (A record) at this
# server; Caddy gets its certificate by itself. pushro.regularhood.in was the first, misspelled name: the app redirects it.
phusro.regularhood.in, pushro.regularhood.in {
	encode gzip
	reverse_proxy app:4000
}
