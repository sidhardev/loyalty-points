{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w web",
  "outputDirectory": "web/dist",
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "habiturn.sidhar.me" }],
      "destination": "https://regularhood.in/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api-habiturn.sidhar.me/api/:path*" },
    { "source": "/sitemap.xml", "destination": "https://api-habiturn.sidhar.me/sitemap.xml" },
    { "source": "/for", "destination": "https://api-habiturn.sidhar.me/for" },
    { "source": "/for/:path*", "destination": "https://api-habiturn.sidhar.me/for/:path*" },
    { "source": "/hi/for", "destination": "https://api-habiturn.sidhar.me/hi/for" },
    { "source": "/hi/for/:path*", "destination": "https://api-habiturn.sidhar.me/hi/for/:path*" },
    { "source": "/(.*)", "destination": "/shell.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
